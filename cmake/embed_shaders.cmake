# Embeds HLSL sources into a generated C++ header as raw string literals.
# Usage: cmake -DSRC_DIR=... -DOUT=... -P embed_shaders.cmake
file(GLOB files "${SRC_DIR}/*.hlsl" "${SRC_DIR}/*.hlsli")
list(SORT files)
set(content "// Generated by embed_shaders.cmake — do not edit.\n#pragma once\nnamespace aether::shaders {\n")
foreach(f ${files})
  get_filename_component(name ${f} NAME)
  string(REPLACE "." "_" var ${name})
  file(READ ${f} src)
  string(APPEND content "inline constexpr const char* ${var} = R\"AETHERHLSL(${src})AETHERHLSL\";\n")
endforeach()
string(APPEND content "}\n")
file(WRITE ${OUT}.tmp "${content}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
